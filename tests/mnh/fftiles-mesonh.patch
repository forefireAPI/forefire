+++ b/src/LIB/FOREFIRE/C_ForeFire_Interface.c
@@ -93,6 +93,18 @@ void MNHInit(double* t) {
 
 }
 
+/* Optional extension: preserve the existing MNHCreateDomain ABI. */
+void MNHSetGeographicGrid(int* nx, double* x, int* ny, double* y,
+                         double* lat, double* lon) {
+    if (my_lib_handle == NULL) loadLib();
+    if (my_lib_handle != NULL) {
+        void (*set_grid)(int, const double*, int, const double*, const double*, const double*);
+        *(void **) (&set_grid) = dlsym(my_lib_handle, "MNHSetGeographicGrid");
+        if (set_grid != NULL) set_grid(*nx, x, *ny, y, lat, lon);
+        /* Older ForeFire libraries continue using their original landscape path. */
+    }
+}
+
