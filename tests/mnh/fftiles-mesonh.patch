+    ! The nested grid uses the parent's Cartesian frame. Register mass-point
+    ! geography in that frame before ForeFire loads fuel or ignition geometry.
+    ! Global axes also let rank zero read a front outside its local partition.
+    IF (.NOT. LCARTESIAN) THEN
+      IF (.NOT. ASSOCIATED(XXHATM_ll) .OR. .NOT. ASSOCIATED(XYHATM_ll)) THEN
+        WRITE(KLUOUT,*) 'ForeFire: global mass-point axes are unavailable'
+        STOP 1
+      END IF
+      IGEO_NX = SIZE(XXHATM_ll)
+      IGEO_NY = SIZE(XYHATM_ll)
+      ALLOCATE(ZFFLAT(IGEO_NX,IGEO_NY), ZFFLON(IGEO_NX,IGEO_NY))
+      DO JGEO = 1, IGEO_NY
+        CALL SM_LATLON(XLATORI, XLONORI, SPREAD(XXHATM_ll,2,1), &
+                      SPREAD(XYHATM_ll(JGEO:JGEO),1,IGEO_NX), &
+                      ZFFLAT(:,JGEO:JGEO), ZFFLON(:,JGEO:JGEO))
+      END DO
+      CALL MNH_TO_FF_GEOGRAPHICGRID(IGEO_NX, XXHATM_ll, IGEO_NY, XYHATM_ll, ZFFLAT, ZFFLON)
+      DEALLOCATE(ZFFLAT, ZFFLON)
+    END IF
